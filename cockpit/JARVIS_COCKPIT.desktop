[Desktop Entry]
Version=1.0
Type=Application
Name=JARVIS Cockpit OS
Comment=Application Bureau Unifiée de Pilotage et Création JARVIS-OMEGA
Exec=/home/pamerys/jarvis/bin/jarvis-cockpit-app
Icon=/home/pamerys/jarvis/cockpit/web/icone.png
Terminal=false
Categories=Utility;Development;System;
StartupWMClass=JarvisCockpit
Actions=NativeGUI;Restart;

[Desktop Action NativeGUI]
Name=Ouvrir en Mode Natif PyQt6
Exec=/home/pamerys/jarvis/bin/jarvis-cockpit-app --native

[Desktop Action Restart]
Name=Redémarrer les Services Cockpit
Exec=/home/pamerys/jarvis/bin/jarvis-cockpit-app --restart
