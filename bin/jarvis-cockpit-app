#!/usr/bin/env bash
# ==============================================================================
# JARVIS COCKPIT APP LAUNCHER — POSTE DE COMMANDE UNIFIÉ (MINING)
# ==============================================================================
set -e

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$DISPLAY" ]; then
    if [ -e "/tmp/.X11-unix/X1" ]; then
        export DISPLAY=":1"
    elif [ -e "/tmp/.X11-unix/X0" ]; then
        export DISPLAY=":0"
    else
        export DISPLAY=":1"
    fi
fi

if [ -z "${XAUTHORITY:-}" ]; then
    if [ -f "$XDG_RUNTIME_DIR/gdm/Xauthority" ]; then
        export XAUTHORITY="$XDG_RUNTIME_DIR/gdm/Xauthority"
    elif [ -f "/run/user/1000/gdm/Xauthority" ]; then
        export XAUTHORITY="/run/user/1000/gdm/Xauthority"
    elif [ -f "$HOME/.Xauthority" ]; then
        export XAUTHORITY="$HOME/.Xauthority"
    fi
fi

export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
COCKPIT_DIR="${COCKPIT_DIR:-$HOME/jarvis/cockpit}"
LOG_DIR="${LOG_DIR:-$HOME/jarvis/logs}"
PROFILE_DIR="${PROFILE_DIR:-$HOME/.config/jarvis-cockpit-profile}"
mkdir -p "$LOG_DIR" "$PROFILE_DIR"

if [ -x "$HOME/jarvis/.venv/bin/python" ]; then
    PYTHON_BIN="$HOME/jarvis/.venv/bin/python"
else
    PYTHON_BIN="python3"
fi

# 1. Gestion des arguments
for arg in "$@"; do
    case "$arg" in
        --restart|-r)
            systemctl --user restart jarvis-cockpit.service 2>/dev/null || true
            sleep 1
            ;;
    esac
done

# 2. Initialisation du multiplexeur TTX en arrière-plan (si nécessaire)
if command -v ttx >/dev/null 2>&1; then
    ttx --init-only >/dev/null 2>&1 || true
elif [ -x "$HOME/.local/bin/ttx" ]; then
    "$HOME/.local/bin/ttx" --init-only >/dev/null 2>&1 || true
fi

# 3. Lancement du Cockpit Unifié (Identique S9 / Standalone Web App ou PyQt6 avec --native)
exec "$COCKPIT_DIR/launch_gui.sh" "$@"

